<title>Jarvis</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{
  --bg:#070b12; --bg2:#0d141f; --panel:#0e1621; --border:#1c2b3d;
  --text:#dbe8f5; --text-dim:#5c7691; --accent:#36d6ff; --accent-dim:#1a3a4a;
  --accent2:#7afcd6; --danger:#ff5d6c;
  color-scheme: dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',Arial,sans-serif;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  padding-left:max(16px, env(safe-area-inset-left,0px));
  padding-right:max(16px, env(safe-area-inset-right,0px));
}
h1,.brand{font-family:'Orbitron',Arial,sans-serif}

.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 0 10px;flex-shrink:0;
}
.brand{font-size:20px;letter-spacing:4px;color:var(--accent);text-transform:uppercase}
.status{font-size:12px;color:var(--text-dim);letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.status-dot{width:8px;height:8px;border-radius:50%;background:var(--text-dim);transition:background .3s,box-shadow .3s}
.status-dot.live{background:var(--accent2);box-shadow:0 0 10px var(--accent2)}

.core-wrap{
  flex:1;display:flex;align-items:center;justify-content:center;
  min-height:0;position:relative;
}
.core{
  width:min(46vw,220px);height:min(46vw,220px);border-radius:50%;
  position:relative;
}
.core .ring{
  position:absolute;inset:0;border-radius:50%;
  border:1px solid var(--border);
}
.core .ring1{inset:0;animation:spin 18s linear infinite}
.core .ring2{inset:14%;border-color:var(--accent-dim);animation:spin 12s linear infinite reverse}
.core .glow{
  position:absolute;inset:28%;border-radius:50%;
  background:radial-gradient(circle at 50% 45%, var(--accent2), var(--accent) 55%, var(--accent-dim) 85%);
  filter:blur(1px);
  box-shadow:0 0 40px 6px var(--accent-dim), 0 0 90px 10px rgba(54,214,255,.18);
  transition:transform .25s ease, box-shadow .25s ease;
}
.core.listening .glow{animation:pulse 1.1s ease-in-out infinite}
.core.speaking .glow{animation:pulse .5s ease-in-out infinite}
@keyframes pulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.12)}
}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

.transcript{
  flex-shrink:0;max-height:34vh;overflow-y:auto;
  display:flex;flex-direction:column;gap:10px;
  padding:14px 4px;
}
.line{font-size:15px;line-height:1.45;max-width:92%}
.line.user{color:var(--text);align-self:flex-end;text-align:right}
.line.user .who{color:var(--text-dim)}
.line.jarvis{color:var(--accent2)}
.line .who{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:2px}

.controls{
  flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:10px;
  padding:14px 0 max(18px, env(safe-area-inset-bottom,0px));
}
.hint{font-size:12px;color:var(--text-dim);text-align:center;min-height:16px}
.mic-btn{
  width:72px;height:72px;border-radius:50%;
  background:var(--panel);border:2px solid var(--accent-dim);
  color:var(--accent);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:border-color .2s,color .2s,transform .1s;
}
.mic-btn:active{transform:scale(.95)}
.mic-btn.on{border-color:var(--accent);color:var(--accent2);box-shadow:0 0 24px var(--accent-dim)}
.mic-btn svg{width:28px;height:28px}
</style>

<div class="topbar">
  <div class="brand">JARVIS</div>
  <div class="status"><span class="status-dot" id="statusDot"></span><span id="statusText">Em espera</span></div>
</div>

<div class="core-wrap">
  <div class="core" id="core">
    <div class="ring ring1"></div>
    <div class="ring ring2"></div>
    <div class="glow"></div>
  </div>
</div>

<div class="transcript" id="transcript"></div>

<div class="controls">
  <div class="hint" id="hint">Toque no botão e fale com o Jarvis</div>
  <button class="mic-btn" id="micBtn" aria-label="Falar com o Jarvis">
